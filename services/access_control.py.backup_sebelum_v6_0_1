def _role_of(user: Any) -> str:
    if user is None:
        return ""
    if isinstance(user, dict):
        return canonical_role(user.get("role"))
    return canonical_role(getattr(user, "role", ""))


def permissions_for(user_or_role: Any) -> set[str]:
    role = canonical_role(user_or_role if isinstance(user_or_role, str) else _role_of(user_or_role))
    permissions = set(ROLE_PERMISSIONS.get(role, set()))
    if role == "super_admin":
        permissions |= ADMIN_ONLY
    return permissions


def has_permission(user: Any, permission: str) -> bool:
    role = _role_of(user)
    if role == "super_admin":
        return True
    requested = LEGACY_PERMISSION_ALIASES.get(permission, permission)
    return requested in ROLE_PERMISSIONS.get(role, set())


def has_any_permission(user: Any, permissions: Iterable[str]) -> bool:
    return any(has_permission(user, permission) for permission in permissions)


def require_permission(user: Any, permission: str) -> None:
    if not has_permission(user, permission):
        raise PermissionError(f"Pengguna tidak memiliki izin: {permission}")
